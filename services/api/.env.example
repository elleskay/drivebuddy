# NestJS API service env. Copy to .env.local for dev. Production values live in
# GitHub Actions secrets and Lambda env vars (set by the CDK stack), never committed.

PORT=3000

# Postgres (Neon serverless for connection pooling on Lambda)
DATABASE_URL=

# JWT signing for tokens issued to the mobile client
JWT_SECRET=

# Push/job queue (SQS). Injected by the NestjsApi construct on Lambda. Unset
# locally: push enqueue no-ops and the in-app notification center still works.
PUSH_QUEUE_URL=

# LTA DataMall account key (traffic/ERP/carpark feeds). Unset: those feeds
# return empty with keyRequired:true.
LTA_ACCOUNT_KEY=

# AI assistant: Anthropic Claude API for answers. Unset: /ai endpoints return 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# S3 scratch bucket for voice clips + Transcribe output. Created and injected by
# the CDK stack on Lambda; unset locally disables the voice path.
AUDIO_BUCKET=

# Comma-separated CORS allowlist for browser clients. Unset reflects the origin.
CORS_ORIGIN=

# Observability
DD_SERVICE=drivebuddy-api
