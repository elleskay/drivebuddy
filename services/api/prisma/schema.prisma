// DriveBuddy database schema (Prisma + Neon Postgres).
// Phase B: auth + user profile + vehicles. Further modules add their models here.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the Lambda is ARM64 on nodejs20.x (Amazon Linux 2023
  // / OpenSSL 3), so the query engine must target linux-arm64-openssl-3.0.x,
  // otherwise the engine binary doesn't match the runtime and every request 500s.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime / Lambda)
  directUrl = env("DIRECT_URL")   // direct (migrations)
}

enum FuelType {
  Petrol
  Hybrid
  Electric
}

/// The four notification categories carried over from the .NET app.
enum NotificationType {
  PRE_DRIVE
  REAL_TIME
  POST_TRIP
  SYSTEM
}

/// A registered user. Combines auth identity and profile (the old .NET split a
/// separate UserProfile keyed by an external Entra UserId; auth is now ours).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String? // null for social-only accounts
  fullName     String
  gender       String?
  dateOfBirth  DateTime? @db.Date
  homeAddress  String?
  provider     String    @default("local") // local | google | apple
  providerId   String? // subject id from the social provider
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicles      Vehicle[]
  routes        DrivingRoute[]
  trips         TripSummary[]
  notifications   Notification[]
  devices         DeviceToken[]
  settings        NotificationSettings?
  recommendations Recommendation[]

  @@index([provider, providerId])
}

/// A user's vehicle. First vehicle becomes main; vehicle number unique per user.
model Vehicle {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber   String
  fuelType        FuelType
  fuelConsumption Decimal  @db.Decimal(5, 2) // kWh/100km (electric) or L/100km (fuel)
  isMain          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, vehicleNumber])
  @@index([userId])
}

/// A recorded drive: a series of GPS points with start/end + computed stats.
model DrivingRoute {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  startTime     DateTime     @default(now())
  endTime       DateTime?
  isActive      Boolean      @default(true)
  totalDistance Float        @default(0) // km
  averageSpeed  Float        @default(0) // km/h
  maxSpeed      Float        @default(0) // km/h
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  points        RoutePoint[]
  summary       TripSummary?

  @@index([userId, startTime])
  @@index([userId, isActive])
}

/// A single GPS sample within a route.
model RoutePoint {
  id        BigInt       @id @default(autoincrement())
  routeId   String
  route     DrivingRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  timestamp DateTime
  latitude  Float
  longitude Float
  altitude  Float?
  speed     Float?
  accuracy  Float?

  @@index([routeId, timestamp])
}

/// Cost + performance summary generated when a trip completes.
model TripSummary {
  id          String       @id @default(uuid())
  routeId     String       @unique
  route       DrivingRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeName   String?
  distanceKm  Float
  durationMin Int
  startTime   DateTime
  endTime     DateTime
  startLat    Float?
  startLng    Float?
  endLat      Float?
  endLng      Float?
  erpCost     Decimal      @default(0) @db.Decimal(10, 2)
  fuelCost    Decimal      @default(0) @db.Decimal(10, 2)
  parkingCost Decimal      @default(0) @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
}

/// An in-app notification. Mirrored to a push if the device has a token + the
/// channel is enabled in NotificationSettings.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json? // arbitrary payload (e.g. { routeId })
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Per-user notification preferences: the four type toggles plus the five
/// real-time alert channels from the .NET app.
model NotificationSettings {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preDrive  Boolean  @default(true)
  realTime  Boolean  @default(true)
  postTrip  Boolean  @default(true)
  system    Boolean  @default(true)
  speed     Boolean  @default(true)
  hazard    Boolean  @default(true)
  erp       Boolean  @default(true)
  traffic   Boolean  @default(true)
  weather   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// A behaviour-derived suggestion for the driver, produced by the route-analysis
/// daily job (and on-demand). Dismissed rows are kept as tombstones so the same
/// suggestion isn't re-surfaced after the user dismisses it.
model Recommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // erp | fuel | routine | safety | carpark
  title     String
  body      String
  score     Float    @default(0) // higher = more relevant; drives sort order
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, dismissed])
}

/// An Expo push token registered by a device. One row per device token.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String? // ios | android
  createdAt DateTime @default(now())

  @@index([userId])
}
