# Repo-level env vars (CI / deploy / tooling). The API's runtime env lives in
# services/api/.env.example; the app reads only EXPO_PUBLIC_* build-time vars.

# AWS (for CDK deploy; CI gets these via OIDC + repo secrets/vars)
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=

# Expo / EAS (mobile app build + submit + OTA update)
EXPO_TOKEN=
EAS_PROJECT_ID=

# --- Deploy-time secrets (GitHub Actions -> CDK synth -> Lambda env) ---
# See .github/workflows/deploy-api.yml for the full mapping.

# Database (Postgres; Neon serverless is the default for connection pooling)
DATABASE_URL=

# Auth (JWT signing for API tokens issued to the mobile client)
JWT_SECRET=

# LTA DataMall account key (live traffic / ERP / carpark feeds)
LTA_ACCOUNT_KEY=

# AI assistant (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Observability
DD_SERVICE=drivebuddy-api

# App build-time (public, inlined into the bundle; never put secrets here)
EXPO_PUBLIC_API_URL=
