{
  "expo": {
    "name": "DriveBuddy",
    "slug": "drivebuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "drivebuddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.elleskay.drivebuddy",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "com.elleskay.drivebuddy",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DriveBuddy uses your location to track your drive route and distance.",
          "locationAlwaysAndWhenInUsePermission": "DriveBuddy tracks your route in the background so your drive keeps recording when the screen is off.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4f8cff"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "DriveBuddy uses your microphone for the voice assistant."
        }
      ],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": false } }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://tq7rrvits7.execute-api.ap-southeast-1.amazonaws.com"
    }
  }
}
